{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "resolveJsonModule":  true,
                            "allowImportingTsExtensions":  true,
                            "noEmit":  true,
                            "types":  [
                                          "vite/client",
                                          "node",
                                          "@wdio/globals/types",
                                          "@wdio/mocha-framework"
                                      ]
                        },
    "include":  [
                    "Frontend",
                    "Tests",
                    "Vite.config.ts",
                    "Playwright.config.ts"
                ]
}
