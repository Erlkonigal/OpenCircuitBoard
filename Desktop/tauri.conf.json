{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCircuitBoard",
  "version": "0.1.0",
  "identifier": "org.opencircuitboard.editor",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCircuitBoard",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "Icons/Icon.png",
      "Icons/Icon.ico"
    ]
  }
}
